{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "NEXT_DEV_DIST_DIR=.next-dev next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "DATABASE_URL=file:$(pwd)/db/custom.db NODE_ENV=production CINEDECK_ROOT=$(pwd) bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "deploy": "bash scripts/deploy.sh",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "bash scripts/db-push.sh",
    "doctor": "bun scripts/doctor.ts",
    "seed": "bun scripts/seed.ts",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test": "bun run test:unit && bun run test:e2e"
  },
